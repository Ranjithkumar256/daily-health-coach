# ==============================================================================
# Daily Health Coach Docker Configuration & Personal Credentials
# ==============================================================================

# 1. Your Docker Hub username
DOCKER_USERNAME=your_dockerhub_username

# 2. Your Docker Hub Personal Access Token (PAT) or Password
DOCKER_PASSWORD=your_dockerhub_token_or_password

# 3. Application Port (defaults to 8001 to run alongside PaisaTrack on 8000)
PORT=8001
